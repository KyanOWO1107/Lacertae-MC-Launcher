<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lacertae.Desktop.ViewModels.Versions"
             x:Class="Lacertae.Desktop.Views.Versions.VersionSettingsView"
             x:DataType="vm:VersionSettingsViewModel">
  <StackPanel Spacing="12">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding DisplayNameDraft}" />
    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
               Text="{Binding FolderName}" />

    <Expander Header="常规" IsExpanded="True">
      <StackPanel Spacing="8" Margin="0,8,0,0">
        <TextBlock Text="显示名称" />
        <TextBox Text="{Binding DisplayNameDraft}" />
        <TextBlock Text="账号覆盖（可选）" />
        <TextBox Text="{Binding AccountIdDraft}" />
      </StackPanel>
    </Expander>

    <Expander Header="隔离" IsExpanded="True">
      <StackPanel Spacing="8" Margin="0,8,0,0">
        <TextBlock Text="每个版本的隔离策略" />
        <ComboBox ItemsSource="{Binding IsolationOptions}"
                  SelectedItem="{Binding IsolationOverride}" />
      </StackPanel>
    </Expander>

    <Expander Header="Java 与内存">
      <StackPanel Spacing="8" Margin="0,8,0,0">
        <TextBlock Text="Java 路径覆盖（可选）" />
        <TextBox Text="{Binding JavaPathDraft}" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <TextBox PlaceholderText="最小 MB" Text="{Binding MinimumMemoryText}" />
          <TextBox Grid.Column="1" PlaceholderText="最大 MB" Text="{Binding MaximumMemoryText}" />
        </Grid>
        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding MemoryModeLabel}"
                   TextWrapping="Wrap" />
        <ComboBox ItemsSource="{Binding GcOptionItems}"
                  SelectedItem="{Binding SelectedGcOption}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal"
                          Spacing="6"
                          IsEnabled="{Binding IsEnabled}">
                <TextBlock Text="{Binding Label}" />
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding DisabledReason}"
                           IsVisible="{Binding IsDisabled}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock IsVisible="{Binding IsJavaSelectionInvalid}"
                   Foreground="{DynamicResource StatusWarningBrush}"
                   Text="手动 Java 仍保持选中，请修复兼容性后再保存。"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Expander>

    <Expander Header="高级参数">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="8" RowSpacing="6">
        <TextBlock Text="JVM 参数（每行一个 token）" />
        <TextBlock Grid.Column="1" Text="游戏参数（每行一个 token）" />
        <TextBox Grid.Row="1"
                 AcceptsReturn="True"
                 MinHeight="100"
                 Text="{Binding JvmArgumentsText}" />
        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 AcceptsReturn="True"
                 MinHeight="100"
                 Text="{Binding GameArgumentsText}" />
      </Grid>
    </Expander>

    <Border Padding="10"
            Background="{DynamicResource StatusErrorBrush}"
            IsVisible="{Binding IsValid, Converter={x:Static BoolConverters.Not}}">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding ValidationError}" TextWrapping="Wrap" />
        <TextBlock IsVisible="{Binding HasValidationLine}"
                   Text="{Binding ValidationLineIndex}" />
      </StackPanel>
    </Border>
    <Button HorizontalAlignment="Left"
            Content="保存版本设置"
            Command="{Binding SaveCommand}"
            IsEnabled="{Binding CanSave}" />

    <Expander Header="重命名文件夹">
      <StackPanel Spacing="8" Margin="0,8,0,0">
        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="这是物理文件夹操作，会先显示来源、目标、引用和恢复行为。" TextWrapping="Wrap" />
        <TextBox Text="{Binding RenameTargetFolderDraft}" />
        <Button HorizontalAlignment="Left"
                Content="生成重命名预览"
                Command="{Binding PrepareRenameCommand}" />
        <TextBlock IsVisible="{Binding HasRenameReferenceSummary}"
                   Foreground="{DynamicResource StatusWarningBrush}"
                   Text="{Binding RenameReferenceSummary}"
                   TextWrapping="Wrap" />
        <Border Padding="10"
                Background="{DynamicResource SurfaceSubtleBrush}"
                IsVisible="{Binding IsRenamePreviewOpen}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding RenamePreview.SourceSummary}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RenamePreview.TargetSummary}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RenamePreview.IsolatedDataSummary}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RenamePreview.RecoverySummary}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="确认重命名" Command="{Binding ConfirmRenameCommand}" />
              <Button Content="取消" Command="{Binding CancelRenameCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
