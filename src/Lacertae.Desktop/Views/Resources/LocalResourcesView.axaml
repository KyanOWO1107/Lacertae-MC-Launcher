<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lacertae.Desktop.ViewModels.Resources"
             x:Class="Lacertae.Desktop.Views.Resources.LocalResourcesView"
             x:DataType="vm:LocalResourcesViewModel">
  <StackPanel Spacing="12">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="本地资源文件夹" />
    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding RootPath}" TextWrapping="Wrap" />
    <Border Padding="10" Background="{DynamicResource StatusErrorBrush}" IsVisible="{Binding HasError}">
      <TextBlock Text="{Binding ErrorCode}" />
    </Border>
    <Border Padding="10" Background="{DynamicResource SurfaceSubtleBrush}" IsVisible="{Binding IsCreateConfirmationOpen}">
      <StackPanel Spacing="6">
        <TextBlock Text="确认创建本地文件夹？" />
        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding PendingFolder.NormalizedPath}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="确认创建" Command="{Binding ConfirmCreateCommand}" />
          <Button Content="取消" Command="{Binding CancelCreateCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
    <ItemsControl ItemsSource="{Binding Folders}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8" ColumnSpacing="8">
            <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding NormalizedPath}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <Button Content="创建" Command="{Binding $parent[ItemsControl].DataContext.CreateCommand}" CommandParameter="{Binding}" />
              <Button Content="打开" Command="{Binding $parent[ItemsControl].DataContext.OpenCommand}" CommandParameter="{Binding}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
