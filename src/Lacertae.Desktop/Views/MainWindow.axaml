<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lacertae.Desktop.ViewModels"
        xmlns:home="using:Lacertae.Desktop.Views.Home"
        xmlns:views="using:Lacertae.Desktop.Views.Java"
        xmlns:versionviews="using:Lacertae.Desktop.Views.Versions"
        xmlns:downloadviews="using:Lacertae.Desktop.Views.Downloads"
        xmlns:taskviews="using:Lacertae.Desktop.Views.Tasks"
        xmlns:resourceviews="using:Lacertae.Desktop.Views.Resources"
        xmlns:onboarding="using:Lacertae.Desktop.Views.Onboarding"
        xmlns:updatevm="using:Lacertae.Desktop.ViewModels.Updates"
        x:Class="Lacertae.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Lacertae"
        Width="960"
        Height="600"
        MinWidth="760"
        MinHeight="480"
        SizeChanged="OnSizeChanged">
  <Grid Background="{DynamicResource SurfaceBaseBrush}">
    <ContentControl IsVisible="{Binding IsOnboardingVisible}">
      <onboarding:OnboardingView DataContext="{Binding Onboarding}" />
    </ContentControl>
    <Border x:Name="WideNavigation"
            Width="220"
            HorizontalAlignment="Left"
            Background="{DynamicResource SurfaceElevatedBrush}"
            Padding="20"
            IsVisible="{Binding IsShellWideNavigation}">
      <StackPanel Spacing="12">
        <TextBlock FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Text="Lacertae" />
        <TextBlock Margin="0,0,0,16"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Minecraft Launcher" />
        <Button HorizontalContentAlignment="Left" Content="主页" Tag="home" Click="NavigateFromButton" />
        <Button HorizontalContentAlignment="Left" Content="版本" Tag="versions" Click="NavigateFromButton" />
        <Button HorizontalContentAlignment="Left" Content="下载" Tag="downloads" Click="NavigateFromButton" />
        <Button HorizontalContentAlignment="Left" Content="资源" Tag="resources" Click="NavigateFromButton" />
        <Button HorizontalContentAlignment="Left" Content="任务" Tag="tasks" Click="NavigateFromButton" />
        <Button Name="SettingsNavigationButton"
                HorizontalContentAlignment="Left"
                Content="设置"
                Tag="settings"
                Click="NavigateFromButton" />
        <ItemsControl Name="WideNavigationItems" IsVisible="False" ItemsSource="{Binding NavigationItems}" />
      </StackPanel>
    </Border>

    <Border x:Name="CompactNavigation"
            Height="78"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="{DynamicResource SurfaceElevatedBrush}"
            Padding="12"
            IsVisible="{Binding IsShellCompactNavigation}">
      <ItemsControl Name="CompactNavigationItems" ItemsSource="{Binding NavigationItems}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NavigationItemViewModel">
            <Button Content="{Binding Label}"
                    ToolTip.Tip="{Binding Description}"
                    Tag="{Binding RouteId}"
                    Click="NavigateFromButton" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <ScrollViewer x:Name="ContentPanel"
                  Margin="220,0,0,0"
                  Padding="32"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  IsVisible="{Binding IsGenericPageVisible}"
                  Classes="generic-page">
      <StackPanel Spacing="16">
        <TextBlock Name="PageHeading"
                   Focusable="True"
                   FontSize="30"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Text="{Binding CurrentPageHeading}" />
        <TextBlock MaxWidth="720"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding CurrentPage.Summary}"
                   TextWrapping="Wrap" />
        <Border Padding="18"
                CornerRadius="{DynamicResource CornerRadius12}"
                Background="{DynamicResource SurfaceSubtleBrush}">
          <StackPanel Spacing="12">
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding CurrentPage.Body}"
                       TextWrapping="Wrap" />
            <TextBlock FontSize="16" Text="当前游戏" />
             <TextBlock Name="VersionSummary"
                        FontSize="22"
                        Text="{Binding VersionSummary}" />
            <Button Name="OpenOnboardingButton"
                    HorizontalAlignment="Left"
                    Content="重新打开首次使用设置"
                    Command="{Binding OpenOnboardingCommand}"
                    IsVisible="{Binding IsSettingsPage}" />
             <Button Name="LaunchButton"
                    Width="160"
                    HorizontalAlignment="Left"
                    Content="启动游戏"
                    IsEnabled="{Binding CanLaunch}" />
          </StackPanel>
        </Border>
        <Border Padding="18"
                CornerRadius="{DynamicResource CornerRadius12}"
                Background="{DynamicResource SurfaceSubtleBrush}">
          <views:JavaSettingsView DataContext="{Binding JavaSettings}" />
        </Border>
      </StackPanel>
    </ScrollViewer>

    <ContentControl x:Name="VersionsContentPanel"
                    Margin="220,0,0,0"
                    Padding="32"
                    IsVisible="{Binding IsVersionsContentVisible}">
      <Grid RowDefinitions="Auto,*" RowSpacing="16">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock FontSize="30"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     Text="版本" />
          <Button Content="关闭版本设置"
                  IsVisible="{Binding IsVersionSettingsVisible}"
                  Command="{Binding CloseVersionSettingsCommand}" />
        </StackPanel>
        <versionviews:VersionsView Grid.Row="1"
                                   DataContext="{Binding Versions}"
                                   IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsVersionSettingsVisible, Converter={x:Static BoolConverters.Not}}" />
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding IsVersionSettingsVisible}">
          <Border Padding="18"
                  CornerRadius="{DynamicResource CornerRadius12}"
                  Background="{DynamicResource SurfaceSubtleBrush}">
            <versionviews:VersionSettingsView DataContext="{Binding VersionSettings}" />
          </Border>
        </ScrollViewer>
      </Grid>
    </ContentControl>

    <ContentControl x:Name="DownloadsContentPanel"
                    Margin="220,0,0,0"
                    Padding="32"
                    IsVisible="{Binding IsDownloadsContentVisible}">
      <downloadviews:VanillaDownloadsView DataContext="{Binding Downloads}" />
    </ContentControl>

    <ContentControl x:Name="TasksContentPanel"
                    Margin="220,0,0,0"
                    Padding="32"
                    IsVisible="{Binding IsTasksContentVisible}">
      <taskviews:TasksView DataContext="{Binding Tasks}" />
    </ContentControl>

    <ContentControl x:Name="ResourcesContentPanel"
                    Margin="220,0,0,0"
                    Padding="32"
                    IsVisible="{Binding IsResourcesContentVisible}">
      <resourceviews:LocalResourcesView DataContext="{Binding Resources}" />
    </ContentControl>

    <Border x:Name="RepairPreviewPanel"
            Width="360"
            Margin="0,24,24,0"
            Padding="18"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            CornerRadius="{DynamicResource CornerRadius12}"
            Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource SurfaceBorderBrush}"
            BorderThickness="1"
            IsVisible="{Binding IsRepairPreviewOpen}">
      <StackPanel Spacing="10">
        <TextBlock FontSize="18"
                   FontWeight="SemiBold"
                   Text="修复预览" />
        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding RepairPreviewSummary}"
                   TextWrapping="Wrap" />
        <Button Name="ConfirmRepairDownloadButton"
                HorizontalAlignment="Left"
                Content="确认修复（后续版本提供）"
                Command="{Binding ConfirmRepairDownloadCommand}"
                IsEnabled="{Binding CanConfirmRepairDownload}"
                ToolTip.Tip="修复下载将在后续版本提供。" />
        <Button HorizontalAlignment="Left"
                Content="关闭预览"
                Command="{Binding CloseRepairPreviewCommand}" />
      </StackPanel>
    </Border>

    <ContentControl x:Name="HomeContentPanel"
                    Margin="220,0,0,0"
                    Padding="32"
                    IsVisible="{Binding IsHomeContentVisible}">
      <home:HomeView DataContext="{Binding Home}" />
    </ContentControl>

    <Border x:Name="UpdateBannerPanel"
            DataContext="{Binding Updates}"
            Width="420"
            Margin="0,18,24,0"
            Padding="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            CornerRadius="{DynamicResource CornerRadius12}"
            Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource SurfaceBorderBrush}"
            BorderThickness="1"
            IsVisible="{Binding IsBannerVisible}">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock FontSize="17"
                     FontWeight="SemiBold"
                     Text="{Binding StateLabel}" />
          <TextBlock Grid.Column="1"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="{Binding Channel}" />
        </Grid>
        <TextBlock Text="{Binding Version, StringFormat=版本：{0}}"
                   IsVisible="{Binding IsAvailable}" />
        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding PackageSize, StringFormat=包大小：{0} bytes}"
                   IsVisible="{Binding IsAvailable}" />
        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="下载和安装会先显示确认，启动中的游戏或安装任务不会被打断。"
                   TextWrapping="Wrap"
                   IsVisible="{Binding IsAvailable}" />
        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="更新已暂存，将在退出游戏后应用。"
                   TextWrapping="Wrap"
                   IsVisible="{Binding IsReadyToApply}" />
        <TextBlock Foreground="{DynamicResource StatusErrorBrush}"
                   Text="{Binding ErrorCode}"
                   IsVisible="{Binding IsFailed}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="查看并下载"
                  Command="{Binding OpenDownloadConfirmationCommand}"
                  IsVisible="{Binding IsAvailable}" />
          <Button Content="确认下载"
                  Command="{Binding ConfirmDownloadCommand}"
                  IsVisible="{Binding IsConfirmationOpen}" />
          <Button Content="取消"
                  Command="{Binding CancelConfirmationCommand}"
                  IsVisible="{Binding IsConfirmationOpen}" />
          <Button Content="退出后更新"
                  Command="{Binding ApplyOnExitCommand}"
                  IsVisible="{Binding IsReadyToApply}" />
          <Button Content="取消暂存"
                  Command="{Binding CancelStagedCommand}"
                  IsVisible="{Binding IsReadyToApply}" />
          <Button Content="重试"
                  Command="{Binding CheckCommand}"
                  IsVisible="{Binding IsFailed}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
