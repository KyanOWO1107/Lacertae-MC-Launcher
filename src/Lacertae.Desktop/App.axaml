<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lacertae.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Lacertae.Desktop/Design/ThemePalette.axaml" />
        <ResourceInclude Source="avares://Lacertae.Desktop/Design/Typography.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Lacertae.Desktop/Design/ControlStyles.axaml" />
  </Application.Styles>
</Application>
