<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="DefaultFontFamily">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
  <x:String x:Key="DefaultFontFamilyName">Segoe UI Variable, Segoe UI, sans-serif</x:String>
  <x:Double x:Key="FontSizeCaption">12</x:Double>
  <x:Double x:Key="FontSizeBody">14</x:Double>
  <x:Double x:Key="FontSizeBodyLarge">16</x:Double>
  <x:Double x:Key="FontSizeTitle">22</x:Double>
  <x:Double x:Key="FontSizeHeading">30</x:Double>
</ResourceDictionary>
