<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:animation="using:Avalonia.Animation"
                    xmlns:controls="using:Avalonia.Controls"
                    xmlns:media="using:Avalonia.Media">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <media:SolidColorBrush x:Key="SurfaceBaseBrush" Color="#F4F7FB" />
      <media:SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFF" />
      <media:SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#EAF0F7" />
      <media:SolidColorBrush x:Key="SurfaceInteractiveBrush" Color="#DFE8F3" />
      <media:SolidColorBrush x:Key="SurfaceBorderBrush" Color="#C2CFDE" />
      <media:SolidColorBrush x:Key="TextPrimaryBrush" Color="#182B49" />
      <media:SolidColorBrush x:Key="TextSecondaryBrush" Color="#43546B" />
      <media:SolidColorBrush x:Key="TextMutedBrush" Color="#5B6D85" />
      <media:SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
      <media:SolidColorBrush x:Key="AccentBrush" Color="#1558A6" />
      <media:SolidColorBrush x:Key="AccentHoverBrush" Color="#104887" />
      <media:SolidColorBrush x:Key="AccentPressedBrush" Color="#0D396B" />
      <media:SolidColorBrush x:Key="FocusRingBrush" Color="#1558A6" />
      <media:SolidColorBrush x:Key="StatusSuccessBrush" Color="#146C43" />
      <media:SolidColorBrush x:Key="StatusWarningBrush" Color="#875A00" />
      <media:SolidColorBrush x:Key="StatusErrorBrush" Color="#B42318" />
      <media:SolidColorBrush x:Key="StatusInfoBrush" Color="#1558A6" />
      <media:SolidColorBrush x:Key="StatusSuccessSurfaceBrush" Color="#E2F3E9" />
      <media:SolidColorBrush x:Key="StatusWarningSurfaceBrush" Color="#FFF3D6" />
      <media:SolidColorBrush x:Key="StatusErrorSurfaceBrush" Color="#FDE8E7" />
      <media:SolidColorBrush x:Key="StatusInfoSurfaceBrush" Color="#E2EFFD" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <media:SolidColorBrush x:Key="SurfaceBaseBrush" Color="#111827" />
      <media:SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#1B2535" />
      <media:SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#202D40" />
      <media:SolidColorBrush x:Key="SurfaceInteractiveBrush" Color="#2A3A51" />
      <media:SolidColorBrush x:Key="SurfaceBorderBrush" Color="#45566E" />
      <media:SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F7FB" />
      <media:SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1" />
      <media:SolidColorBrush x:Key="TextMutedBrush" Color="#A9B7C9" />
      <media:SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
      <media:SolidColorBrush x:Key="AccentBrush" Color="#4F8EDB" />
      <media:SolidColorBrush x:Key="AccentHoverBrush" Color="#5B96D9" />
      <media:SolidColorBrush x:Key="AccentPressedBrush" Color="#3A76BE" />
      <media:SolidColorBrush x:Key="FocusRingBrush" Color="#75B5FF" />
      <media:SolidColorBrush x:Key="StatusSuccessBrush" Color="#69D39B" />
      <media:SolidColorBrush x:Key="StatusWarningBrush" Color="#F2C66D" />
      <media:SolidColorBrush x:Key="StatusErrorBrush" Color="#FF9B93" />
      <media:SolidColorBrush x:Key="StatusInfoBrush" Color="#75B5FF" />
      <media:SolidColorBrush x:Key="StatusSuccessSurfaceBrush" Color="#153A2A" />
      <media:SolidColorBrush x:Key="StatusWarningSurfaceBrush" Color="#473716" />
      <media:SolidColorBrush x:Key="StatusErrorSurfaceBrush" Color="#4D2425" />
      <media:SolidColorBrush x:Key="StatusInfoSurfaceBrush" Color="#193652" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <x:Double x:Key="Spacing4">4</x:Double>
  <x:Double x:Key="Spacing8">8</x:Double>
  <x:Double x:Key="Spacing12">12</x:Double>
  <x:Double x:Key="Spacing16">16</x:Double>
  <x:Double x:Key="Spacing24">24</x:Double>
  <x:Double x:Key="Spacing32">32</x:Double>

  <CornerRadius x:Key="CornerRadius8">8</CornerRadius>
  <CornerRadius x:Key="CornerRadius12">12</CornerRadius>
  <CornerRadius x:Key="CornerRadius16">16</CornerRadius>
  <CornerRadius x:Key="CornerRadiusSmall">8</CornerRadius>
  <CornerRadius x:Key="CornerRadiusMedium">12</CornerRadius>
  <CornerRadius x:Key="CornerRadiusLarge">16</CornerRadius>

  <media:BoxShadows x:Key="Elevation1">0 1 3 0 #240B1E38</media:BoxShadows>
  <media:BoxShadows x:Key="Elevation2">0 4 12 0 #300B1E38</media:BoxShadows>
  <media:BoxShadows x:Key="Elevation3">0 10 24 0 #3D0B1E38</media:BoxShadows>
  <media:BoxShadows x:Key="ElevationLow">0 1 3 0 #240B1E38</media:BoxShadows>
  <media:BoxShadows x:Key="ElevationMedium">0 4 12 0 #300B1E38</media:BoxShadows>
  <media:BoxShadows x:Key="ElevationHigh">0 10 24 0 #3D0B1E38</media:BoxShadows>

  <Thickness x:Key="ButtonPadding">16,10</Thickness>
  <Thickness x:Key="TextFieldPadding">12,8</Thickness>
  <x:TimeSpan x:Key="MotionDuration">00:00:00.150</x:TimeSpan>
  <x:TimeSpan x:Key="MotionDurationReduced">00:00:00</x:TimeSpan>
  <x:Double x:Key="MotionTransformDistance">4</x:Double>
  <x:Double x:Key="MotionTransformDistanceReduced">0</x:Double>
  <x:Boolean x:Key="ReduceMotion">False</x:Boolean>
  <animation:Transitions x:Key="MotionTransitions">
    <animation:DoubleTransition Property="{x:Static controls:Control.OpacityProperty}" Duration="00:00:00.150" />
  </animation:Transitions>
</ResourceDictionary>
